{
  "data": {
    "manifest": "data/prepared/index.csv",
    "candidates": "data/prepared/candidates.csv",
    "num_candidates": 294,
    "fields": {
      "channel": "h_vary",
      "snr": "snr_db",
      "ber": "mean_coded_ber",
      "candidate_ids": "candidate_ids"
    },
    "axis_order": "time_delay",
    "hdf5_matlab_order": true,
    "crop": {
      "already_cropped": false,
      "time_start_matlab": 626,
      "time_stop_matlab": 4000,
      "main_path_matlab": 501,
      "delay_before": 250,
      "delay_after": 250,
      "allow_short": false
    },
    "features": "ri_abs_phase",
    "temporal_pool": 16,
    "phase_power_floor": 1e-06,
    "cache_features": false
  },
  "model": {
    "kind": "scorer",
    "d_model": 64,
    "heads": 4,
    "layers": 4,
    "ffn_dim": 128,
    "dropout": 0.15,
    "delay_bins": 8,
    "candidate_dim": 32,
    "snr_conditioning": "film"
  },
  "loss": {
    "scale_floor": 0.001,
    "temperature": 0.2,
    "score_weight": 1.0,
    "soft_weight": 0.5,
    "regret_weight": 1.0,
    "rank_weight": 0.05,
    "rank_pairs": 256,
    "warmup_epochs": 3
  },
  "training": {
    "seed": 42,
    "epochs": 80,
    "batch_size": 4,
    "workers": 0,
    "learning_rate": 0.0005,
    "weight_decay": 0.001,
    "gradient_clip": 1.0,
    "patience": 20,
    "amp": true,
    "device": "auto",
    "output": "outputs/new_training",
    "cpu_threads": 4,
    "mode": "all_data",
    "target_metric": "MeanCodedBER"
  },
  "evaluation": {
    "tie_tolerance": 1e-08,
    "bootstrap_repeats": 500
  },
  "simulation": {
    "mode": "offline_replay",
    "selection_target": "MeanCodedBER",
    "note": "请在新电脑记录实际编码、训练长度、采样率和SNR定义；不得把旧实验条件当成新数据事实。"
  }
}